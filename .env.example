# Copy to .env.local for local development, and set the same keys in Vercel.

# Secret used to sign staff session tokens — generate with: openssl rand -hex 32
AUTH_SECRET=

# Initial staff account created on first run
ADMIN_EMAIL=admin@atlasreit.com
ADMIN_PASSWORD=
ADMIN_NAME=Site Administrator

# Production database URL (Neon / Postgres). Leave empty locally.
POSTGRES_URL=

# Optional: Vercel Blob store token for photo uploads in production
# (Marketplace → Blob → attach; it injects BLOB_READ_WRITE_TOKEN automatically)
BLOB_READ_WRITE_TOKEN=
