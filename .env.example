# Copy to .env.local for local development, and set the same keys in Vercel.

# Secret used to sign staff session tokens — generate with: openssl rand -hex 32
AUTH_SECRET=

# Initial administrator is created only when a password is provided; no default credentials
ADMIN_EMAIL=admin@atlasreit.com
ADMIN_PASSWORD=
ADMIN_NAME=Site Administrator

# Production database URL (Neon / Postgres). Leave empty locally.
POSTGRES_URL=
# Optional PEM CA certificate for managed Postgres using a private CA; TLS verification stays enabled.
# Use literal \n sequences for line breaks when configured as an environment variable.
PGSSL_CA=

# One-time migration for old listing prices. The original site used USD.
# Set the legacy currency before the first startup against an existing database.
# For USD data, also set the approved conversion rate; the app will refuse an ambiguous migration.
# LEGACY_LISTINGS_CURRENCY=USD
# LEGACY_LISTINGS_USD_TO_DZD_RATE=

# Optional: Vercel Blob store token for photo uploads in production
# (Marketplace → Blob → attach; it injects BLOB_READ_WRITE_TOKEN automatically)
BLOB_READ_WRITE_TOKEN=

# Tenant account mail (no credentials are included here).
# EMAIL_PROVIDER may be "resend" in production. Tests set EMAIL_PROVIDER=test and do not send messages.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=
TENANT_INVITE_TTL_MINUTES=1440
TENANT_RESET_TTL_MINUTES=30
TENANT_REGISTRATION_CODE_TTL_MINUTES=10
# Google OAuth for tenant portal sign-in (configure OAuth consent + redirect URI in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI: https://your-domain.example/api/tenant-auth/google/callback

# Daily Vercel cron for lease-end alerts (90/60/30-day notifications).
CRON_SECRET=

# Optional isolated integration test DB (must be disposable; DB name must contain test or ci).
# ATLAS_TEST_POSTGRES_URL=
